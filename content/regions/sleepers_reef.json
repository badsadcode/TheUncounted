  "interactables": [
    {
      "instance_id": "light_plaque",
      "type": "readable",
      "model": "",
      "pos": [
        0.0,
        0.0,
        -5.6
      ],
      "rot_y": 0.0,
      "prompt": "Read the Plaque by the Door",
      "title": "The Saltmere Light",
      "text": "SALTMERE LIGHT\nRaised in the Year of the Long Tide by the Fishermen's Guild\n\"So that every boat comes home, and every name with it.\"\n\nKEEPERS: J. Marsh. P. Marsh. E. Marsh. O. Marsh.\n\nThe last name has no end date. Below it, scratched with something sharp, a tally of days: so many that they cover the bottom of the plaque, the doorframe, and the first yard of the tower wall.",
      "set_flag": "reef_plaque"
    },
    {
      "instance_id": "keeper_log",
      "type": "readable",
      "model": "",
      "pos": [
        -2.6,
        5.6,
        -10.6
      ],
      "rot_y": 0.0,
      "prompt": "Read the Keeper's Log",
      "title": "Log of the Saltmere Light, O. Marsh",
      "text": "\"Day 1. Father's gone. I keep the light now. It's not hard. Trim the wick, fill the oil, wind the clock. And never let it go out.\"\n\n\"Day 900. Father said the light isn't for ships. It's for the thing under the reef. While it can see the light, it dreams. While it dreams, it isn't hungry. I thought he was joking. He wasn't.\"\n\n\"Day 20,000 (I think). I died some time ago. I've kept the light anyway. Nobody has come to relieve me. I don't mind. Somebody has to.\"\n\n\"Day ?. The men in robes came and sang, and the light went out. It has never gone out. I can't relight it. My hands go through the matches now. I need someone who's still solid. I need someone it can't see.\"",
      "set_flag": "reef_log",
      "sanity": -4
    },
    {
      "instance_id": "reef_bottle_tom",
      "type": "readable",
      "model": "",
      "pos": [
        8.5,
        0.0,
        6.5
      ],
      "rot_y": 0.0,
      "prompt": "Pick Up the Bottle",
      "title": "A Name in a Bottle: THOMAS GALE",
      "text": "A green bottle, stoppered with wax, wedged between two rocks. Inside, a strip of sailcloth with a name stitched on it in red thread, the stitches small and careful, the kind a mother makes:\n\nTHOMAS GALE\n\nUnderneath, in smaller stitches: \"Eldest. Bad at knots. Good at laughing.\"\n\nIt feels warm in your hand. It feels like it's been waiting.",
      "set_flag": "reef_tom",
      "sanity": 2
    },
    {
      "instance_id": "reef_bottle_abel",
      "type": "readable",
      "model": "",
      "pos": [
        -10.0,
        0.0,
        -3.5
      ],
      "rot_y": 0.0,
      "prompt": "Pick Up the Bottle",
      "title": "A Name in a Bottle: ABEL GALE",
      "text": "A brown bottle, half buried in sand. Inside, a page torn from a school primer, the alphabet down one side and, in a child's enormous letters, practised over and over until the page ran out:\n\nABEL GALE  ABEL GALE  ABEL GALE  ABEL GALE\n\nAt the bottom, in an adult hand: \"He was so proud when he could write it. -S.\"",
      "set_flag": "reef_abel",
      "sanity": 2
    },
    {
      "instance_id": "reef_bottle_fenn",
      "type": "readable",
      "model": "",
      "pos": [
        10.5,
        0.0,
        -6.5
      ],
      "rot_y": 0.0,
      "prompt": "Pick Up the Bottle",
      "title": "A Name in a Bottle: BARTHOLOMEW FENN",
      "text": "A bottle with a ship in it. A very small ship. On the deck of the very small ship, a very small man is holding up a very small fish, triumphantly. The label reads:\n\nBARTHOLOMEW 'BART' FENN\nWanted to be remembered as the man who caught the Big One. Caught it. It ate him. Remember him anyway.",
      "set_flag": "reef_fenn",
      "sanity": 2
    },
    {
      "instance_id": "reef_bottle_nan",
      "type": "readable",
      "model": "",
      "pos": [
        -4.5,
        0.0,
        10.5
      ],
      "rot_y": 0.0,
      "prompt": "Pick Up the Bottle",
      "title": "A Name in a Bottle: GRANNY WEATHERBY",
      "text": "A jam jar. The label still says 'DAMSON, LAST SUMMER'. Inside, a recipe card:\n\nGRANNY WEATHERBY'S CHOWDER\n(Do not tell Brine. Brine thinks hers is better. Brine is wrong.)\n\nThe recipe is long, specific, and ends with: \"...and a pinch of salt for every name you love. Use a lot of salt.\"",
      "set_flag": "reef_nan",
      "sanity": 2
    },
    {
      "instance_id": "reef_bottle_nobody",
      "type": "readable",
      "model": "",
      "pos": [
        3.5,
        0.0,
        9.0
      ],
      "rot_y": 0.0,
      "prompt": "Pick Up the Bottle",
      "title": "A Name in a Bottle: (blank)",
      "text": "A clear glass bottle, very old, the glass gone milky with salt. There's a slip of paper inside. You shake it out.\n\nIt's blank.\n\nNot faded. Blank. Somebody put a name in here once, and the sea took the name and left the paper, and sent the paper home anyway, because the sea, for all its hunger, has a sense of form.\n\nYou keep the paper. It seems wrong not to. Nobody should be nobody.",
      "set_flag": "reef_nobody",
      "sanity": 2
    },
    {
      "instance_id": "reef_bottle_marsh",
      "type": "readable",
      "model": "",
      "pos": [
        -13.5,
        0.0,
        6.5
      ],
      "rot_y": 0.0,
      "prompt": "Pick Up the Bottle",
      "title": "A Name in a Bottle: ONDINE MARSH",
      "text": "A lamp-glass, of all things, the chimney off an old oil lamp, stoppered at both ends with cork. Inside, a lock of grey hair tied with string, and a label in a neat, tired hand:\n\nONDINE MARSH. Keeper.\n\n\"If anyone finds this, I was here. I kept the light. Please tell somebody.\"",
      "set_flag": "reef_ondine",
      "sanity": 2
    },
